#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-3.0

# Configuration
SCRIPTDIR=$(dirname "$_")
PARENTDIR=$(realpath "${SCRIPTDIR}/..")
BINDIR=$(realpath "${SCRIPTDIR}/bin")
MAGISKBOOT=$BINDIR/magiskboot
KSUD=$BINDIR/ksud-x86_64-unknown-linux-musl
AVBTOOL=$BINDIR/avb/avbtool.py
KERNELPATH=$PARENTDIR/out/target/product/a24/obj/KERNEL_OBJ/kernel-5.10/arch/arm64/boot/
WORKSPACE=$BINDIR/workspace
CERTDIR=$BINDIR/certs

# -------- Argument parsing --------
KSU_VARIANT=""
INCLUDE_VBMETA=false

# -------- Colors & logging --------
RED="\e[1;31m"
GREEN="\e[1;32m"
YELLOW="\e[1;33m"
RESET="\e[0m"

print_msg() {
    local color="$1"; shift
    printf "%b%s%b\n" "${color}" "$*" "${RESET}"
}

_log_handler() {
    local color="$1"
    local level="$2"
    shift 2
    
    local nl=""
    [[ "$1" == "-n" ]] && { nl="\n"; shift; }
    
    printf "${nl}%b[%s] %s%b\n" "${color}" "${level}" "$*" "${RESET}"
}

info() { _log_handler "${GREEN}"  "INFO"  "$@"; }
warn() { _log_handler "${YELLOW}" "WARN"  "$@"; }
err()  { _log_handler "${RED}"    "ERROR" "$@"; }

print_msg "$GREEN" " - Build script for Samsung kernel image - "
print_msg "$RED" "       by poqdavid "
print_msg "$RED" ""

usage() {
    info "Usage: $0 [--ksu | --ksun | --resukisu]"
    info -n "  --ksu       Build/repack using KernelSU"
    info "  --ksun      Build/repack using KernelSU-Next"
    info "  --resukisu  Build/repack using ReSukiSU"
    info "  --vbm       Include vbmeta.img.lz4 in the output tar (if present)"
    info "  (none)      Build/repack the stock kernel (no root, no KSU checks)"
    exit 1
}

while [[ $# -gt 0 ]]; do
    case "$1" in
        --ksu)
            KSU_VARIANT="ksu"
            shift
        ;;
        --ksun|--ksu-next)
            KSU_VARIANT="ksun"
            shift
        ;;
        --resukisu)
            KSU_VARIANT="resukisu"
            shift
        ;;
        --vbm|--include-vbmeta)
            INCLUDE_VBMETA=true
            shift
        ;;
        -h|--help)
            usage
        ;;
        *)
            err "Unknown option: $1"
            usage
        ;;
    esac
done

if [[ -z "$KSU_VARIANT" ]]; then
    KSU_VARIANT="stock"
fi

case "$KSU_VARIANT" in
    ksu)
        KSU_DIR_NAME="KernelSU"
        OUTPUT_PREFIX="kernelsu"
        KSUDIR=$PARENTDIR/kernel-5.10/$KSU_DIR_NAME
        info -n "Selected KernelSU variant: ${KSU_DIR_NAME}"
    ;;
    ksun)
        KSU_DIR_NAME="KernelSU-Next"
        OUTPUT_PREFIX="kernelsunext"
        KSUDIR=$PARENTDIR/kernel-5.10/$KSU_DIR_NAME
        info -n "Selected KernelSU variant: ${KSU_DIR_NAME}"
    ;;
    resukisu)
        KSU_DIR_NAME="KernelSU"
        OUTPUT_PREFIX="resukisu"
        KSUDIR=$PARENTDIR/kernel-5.10/$KSU_DIR_NAME
        info -n "Selected KernelSU variant: ReSukiSU"
    ;;
    stock)
        OUTPUT_PREFIX="stock_optimized"
        warn -n "No --ksu/--ksun given. Building a stock (non-rooted) kernel package."
    ;;
esac

checks() {
    info -n "Starting environment checks..."
    
    if [ ! -d "${WORKSPACE}" ]; then
        info -n "WORKSPACE directory not found. Creating directory at ${WORKSPACE}..."
        pushd "$BINDIR" > /dev/null
        mkdir workspace > /dev/null 2>&1
        pushd $PARENTDIR > /dev/null
        info -n "WORKSPACE directory created."
    else
        info -n "WORKSPACE directory exists."
    fi
    
    info -n "Cleaning up WORKSPACE directory..."
    rm -rf $WORKSPACE/*
    info -n "WORKSPACE cleaned."
    
    if [ ! -d "${CERTDIR}" ]; then
        info -n "CERTS directory not found. Creating directory at ${CERTDIR}..."
        pushd "$BINDIR" > /dev/null
        mkdir certs > /dev/null 2>&1
        pushd $PARENTDIR > /dev/null
        info -n "CERTS directory created."
    else
        info -n "CERTS directory exists."
    fi
    
    if [ ! -d "${KERNELPATH}" ]; then
        err -n "Kernel path not found: ${KERNELPATH}"
        err -n "Aborting environment checks..."
        exit 1
    else
        info -n "Kernel path found: ${KERNELPATH}"
    fi
    
    if [[ "$KSU_VARIANT" == "stock" ]]; then
        info -n "Stock build selected. Skipping KernelSU component checks."
    else
        if [ ! -f "${KSUD}" ]; then
            err -n "KSUD not found: ${KSUD}"
            err -n "Aborting..."
            exit 1
        else
            info -n "Found KSUD at ${KSUD}."
        fi
        
        if [ ! -d "${KSUDIR}" ]; then
            err -n "${KSU_DIR_NAME} directory not found: ${KSUDIR}"
            err -n "Aborting..."
            exit 1
        else
            info -n "Found ${KSU_DIR_NAME} at ${KSUDIR}."
        fi
    fi
    
    if [ ! -f "${MAGISKBOOT}" ]; then
        err -n "Magiskboot not found: ${MAGISKBOOT}"
        err -n "Aborting..."
        exit 1
    else
        info -n "Found MAGISKBOOT at ${MAGISKBOOT}."
    fi
    
    if ! command -v lz4 &> /dev/null; then
        err -n "lz4 is not installed. Please run:"
        err -n "sudo apt install lz4 -y"
        err -n "Aborting..."
        exit 1
    else
        info -n "lz4 is installed."
    fi
    
    if ! command -v python3 &> /dev/null; then
        err -n "python3 is not installed. Please run:"
        err -n "sudo apt install python3 -y"
        err -n "Aborting..."
        exit 1
    else
        info -n "python3 is installed."
    fi
    
    if [ -f "${PARENTDIR}/repackfiles/boot.img.lz4" ]; then
        info -n "Found boot.img.lz4. Decompressing now..."
        lz4 -B6 --content-size -f repackfiles/boot.img.lz4 repackfiles/boot.img
        info -n "Decompression complete."
    else
        info -n "No compressed boot image detected."
    fi
    
    if [ ! -f "${PARENTDIR}/repackfiles/boot.img" ]; then
        err -n "boot.img not found in ${PARENTDIR}!"
        err -n "Please place your boot.img in ${PARENTDIR}."
        err -n "Aborting..."
        exit 1
    else
        info -n "boot.img is available."
    fi
    info -n "Environment checks completed successfully."
}

unpack() {
    info -n "Generating a signing key (if not already present)..."
    if [ ! -f $CERTDIR/sign.pub.bin ]; then
        openssl req -new -x509 -newkey rsa:4096 -keyout $CERTDIR/sign.pk8 -out $CERTDIR/sign.pem -days 824 -nodes -sha256 -config $BINDIR/samsung_cert.conf
        info -n "Signing key generated successfully."
    else
        info -n "Signing key already exists. Skipping generation."
    fi
    
    info -n "Extracting public key from the signing key..."
    python3 "${AVBTOOL}" extract_public_key --key $CERTDIR/sign.pk8 --output $CERTDIR/sign.pub.bin
    info -n "Public key extracted successfully."
    
    info -n "Starting unpacking of boot.img..."
    pushd "$WORKSPACE" > /dev/null
    $MAGISKBOOT unpack -n "${PARENTDIR}/repackfiles/boot.img"
    rm kernel
    pushd "$PARENTDIR" > /dev/null
    info -n "Boot image unpacked successfully."
    
    info -n "Returning to parent directory..."
}

repack() {
    if [ ! -f "${KERNELPATH}/Image" ]; then
        err -n "No Kernel Image found in ${KERNELPATH}!"
        err -n "Aborting repack process..."
        exit 1
    else
        info -n "Kernel Image found. Copying to temporary file..."
        cp -f "${KERNELPATH}/Image" "${WORKSPACE}/kernel"
        info -n "Kernel Image copied successfully."
        
        info -n "Starting repacking of boot image..."
        pushd "$WORKSPACE" > /dev/null
        $MAGISKBOOT repack "${PARENTDIR}/repackfiles/boot.img" "${WORKSPACE}/new-boot.img"
        pushd "$PARENTDIR" > /dev/null
        info -n "Boot image repacked into new-boot.img."
        
        cp -f $WORKSPACE/new-boot.img $WORKSPACE/new-boot-signed.img
        info -n "Boot image Copied to ${WORKSPACE}/new-boot-signed.img."
        
        mv $WORKSPACE/new-boot.img $PARENTDIR/repackfiles/boot-repacked.img
        info -n "Repacked boot image moved to ${PARENTDIR}/repackfiles/boot-repacked.img."
        
        info -n "Signing boot image..."
        python3 "${AVBTOOL}" add_hash_footer --partition_name boot --partition_size $((64 * 1024 * 1024)) --image $WORKSPACE/new-boot-signed.img --algorithm SHA256_RSA4096 --key $CERTDIR/sign.pk8
        
        info -n "Boot image signed successfully."
        
        mv $WORKSPACE/new-boot-signed.img $PARENTDIR/repackfiles/boot-repacked-signed.img
        info -n "Repacked boot image moved to ${PARENTDIR}/repackfiles/boot-repacked-signed.img."
        
        info -n "Repacking process completed successfully."
        return 0
    fi
}

package_tar() {
    info -n "Packaging boot-repacked-signed.img into tar archive..."
    
    if [[ "$KSU_VARIANT" == "stock" ]]; then
        VERSION_TAG=$(strings "${KERNELPATH}/Image" 2>/dev/null | grep -m1 -oP 'Linux version \K[0-9]+\.[0-9]+\.[0-9]+')
        if [[ -z "$VERSION_TAG" ]]; then
            warn -n "Could not read kernel release from Image. Falling back to build date."
            VERSION_TAG=$(date +%Y%m%d)
        fi
    else
        BASE_VERSION=$(grep -m1 'expr' ${KSUDIR}/kernel/Kbuild | grep -oP '(?<![.\w])[0-9]+(?!\w)' | awk '{s+=$1} END{print s+0}')
        VERSION_TAG=$(( $(git -C ${KSUDIR} rev-list --count HEAD) + BASE_VERSION ))
    fi
    
    OUTTAR="../${OUTPUT_PREFIX}_${VERSION_TAG}_A245FXXS9DYG1_A24_GKI.tar"
    
    if [ ! -f "${PARENTDIR}/repackfiles/boot-repacked-signed.img" ]; then
        err -n "Signed repacked boot image not found at ${PARENTDIR}/boot-repacked-signed.img"
        err -n "Skipping tar packaging."
        return 1
    fi
    
    TMPDIR=$(mktemp -d)
    
    info -n "Created temp directory at $TMPDIR"
    
    if [ ! -d "${PARENTDIR}/release" ]; then
        mkdir -p "${PARENTDIR}/release"
        info -n "Created release directory at ${PARENTDIR}/release"
    fi
    
    cp -f "${PARENTDIR}/repackfiles/boot-repacked-signed.img" "${TMPDIR}/boot.img"
    
    if [[ -f "${PARENTDIR}/repackfiles/vbmeta.img.lz4" && "$INCLUDE_VBMETA" == true ]]; then
        cp -f "${PARENTDIR}/repackfiles/vbmeta.img.lz4" "${TMPDIR}/vbmeta.img.lz4"
        SRCFILES="boot.img vbmeta.img.lz4"
    else
        SRCFILES="boot.img"
    fi
    
    cd "$TMPDIR"
    tar -H ustar -c -f "${PARENTDIR}/release/${OUTTAR##*/}" $SRCFILES
    
    if [ -f "${PARENTDIR}/release/${OUTTAR##*/}" ]; then
        info -n "Tar archive created at ${PARENTDIR}/release/${OUTTAR##*/}"
    else
        err -n "Failed to create tar archive."
        return 1
    fi
    
    trap 'rm -rf "$TMPDIR"' EXIT
    
    info -n "Deleted temp directory at $TMPDIR"
    info -n "Packaging completed successfully."
    return 0
}

checks
unpack
repack
package_tar
